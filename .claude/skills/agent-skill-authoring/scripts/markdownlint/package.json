{
  "name": "agent-skill-markdownlint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Protected file-based agent skill checks using markdownlint-cli2.",
  "exports": {
    ".": "./rules.mjs",
    "./context": "./context.mjs",
    "./run": "./run.mjs"
  },
  "bin": {
    "agent-skill-markdownlint": "./cli.mjs"
  },
  "files": [
    "*.mjs",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "markdownlint-cli2": "0.23.3",
    "markdown-it": "15.0.1",
    "yaml": "2.8.2"
  }
}
