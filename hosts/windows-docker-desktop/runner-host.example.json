{
  "imageName": "actions-runner:local",
  "repositories": [
    {
      "owner": "example-owner",
      "repository": "example-repo-one",
      "name": "example-repo-one",
      "slots": 2,
      "tokenPath": "C:\\path\\to\\example-repo-one.token",
      "labels": ["axpc", "example-label-one"],
      "volumes": [
        { "suffix": "toolcache", "mountPath": "/opt/hostedtoolcache" },
        { "suffix": "cargo", "mountPath": "/home/runner/.cargo" },
        { "suffix": "rustup", "mountPath": "/home/runner/.rustup" },
        { "suffix": "npm", "mountPath": "/home/runner/.npm" }
      ]
    },
    {
      "owner": "example-owner",
      "repository": "example-repo-two",
      "name": "example-repo-two",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\example-repo-two.token",
      "labels": ["axpc", "example-label-two"],
      "cpus": 4,
      "memoryGb": 16,
      "volumes": [
        { "suffix": "toolcache", "mountPath": "/opt/hostedtoolcache" },
        { "suffix": "npm", "mountPath": "/home/runner/.npm" }
      ]
    }
  ]
}
