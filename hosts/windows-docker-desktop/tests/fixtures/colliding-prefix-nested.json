{
  "hostPrefix": "runner-host",
  "imageName": "actions-runner:local",
  "repositories": [
    {
      "owner": "a",
      "repository": "b",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\b.token",
      "labels": ["example-label-b"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ]
    },
    {
      "owner": "a",
      "repository": "b-c",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\b-c.token",
      "labels": ["example-label-b-c"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ]
    }
  ]
}
