{
  "imageName": "actions-runner:local",
  "repositories": [
    {
      "owner": "example-owner",
      "repository": "example-repo-one",
      "name": "example-repo-one",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\example-repo-one.token",
      "labels": ["example-label-example-repo-one"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ],
      "cpus": 1.5,
      "memoryGb": 16
    }
  ]
}
