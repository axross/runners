      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ],
      "cpus": 1.5e-9
    },
    {
      "owner": "example-owner",
      "repository": "example-repo-3",
      "name": "example-repo-3",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\example-repo-3.token",
      "labels": ["example-label-3"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ],
      "cpus": 1e1
    },
    {
      "owner": "example-owner",
      "repository": "example-repo-4",
      "name": "example-repo-4",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\example-repo-4.token",
      "labels": ["example-label-4"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ],
      "cpus": 0.1234567895
    }
  ]
}
