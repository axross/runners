{
  "imageName": "actions-runner:local",
  "repositories": [
    {
      "owner": "example-owner",
      "repository": "example-repo-1",
      "name": "example",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\example-repo-1.token",
      "labels": ["example-label-1"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ]
    },
    {
      "owner": "example-owner",
      "repository": "example-repo-2",
      "name": "example",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\example-repo-2.token",
      "labels": ["example-label-2"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ],
      "cpus": "x"
    }
  ]
}
