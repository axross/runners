{
  "imageName": "actions-runner:local",
  "repositories": [
    {
      "owner": "example-owner",
      "repository": "example-repo-1",
      "name": "example-repo-1",
      "slots": 1,
      "tokenPath": "C:\\path\\to\\example-repo-1.token",
      "labels": ["example-label-1"],
      "volumes": [
        {
          "suffix": "npm",
          "mountPath": "/home/runner/.npm"
        }
      ],
      "cpus": 4.9999999999999e-10
    }
  ]
}
